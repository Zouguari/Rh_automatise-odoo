<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hr_employee_credentials_form" model="ir.ui.view">
        <field name="name">hr.employee.credentials.form</field>
        <field name="model">hr.employee.credentials</field>
        <field name="arch" type="xml">
            <form string="Identifiants Employé Mobile">
                <header>
                    <button name="action_reset_password"
                            string="Réinitialiser le mot de passe"
                            type="object"
                            class="btn-primary"
                            groups="hr.group_hr_user,hr.group_hr_manager,base.group_system"
                            confirm="Êtes-vous sûr de vouloir réinitialiser le mot de passe d'accès de cet employé ? Le mot de passe actuel sera immédiatement révoqué."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id" class="oe_edit_only"/>
                        <h1>
                            <field name="employee_id" placeholder="Sélectionner l'employé..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identifiants &amp; Connexion">
                            <field name="login"/>
                            <field name="must_change_password"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Audit &amp; Activité">
                            <field name="last_login" readonly="1"/>
                            <field name="last_password_reset" readonly="1"/>
                            <field name="reset_by" readonly="1"/>
                            <field name="create_date" string="Créé le" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_hr_employee_credentials_tree" model="ir.ui.view">
        <field name="name">hr.employee.credentials.tree</field>
        <field name="model">hr.employee.credentials</field>
        <field name="arch" type="xml">
            <tree string="Identifiants Employés Mobile">
                <field name="employee_id"/>
                <field name="login"/>
                <field name="must_change_password"/>
                <field name="is_active"/>
                <field name="last_login"/>
                <field name="last_password_reset"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_employee_credentials" model="ir.actions.act_window">
        <field name="name">Accès Mobile Employés</field>
        <field name="res_model">hr.employee.credentials</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun compte d'accès mobile créé.
            </p>
            <p>
                Créez et gérez les identifiants de connexion mobile de vos collaborateurs sans nécessiter de compte utilisateur Odoo.
            </p>
        </field>
    </record>

    <!-- Menu Item under HR Management -->
    <menuitem id="menu_hr_employee_credentials"
              name="Accès Mobile Employés"
              parent="hr.menu_hr_root"
              action="action_hr_employee_credentials"
              sequence="95"/>
</odoo>

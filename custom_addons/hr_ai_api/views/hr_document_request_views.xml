<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hr_document_request_form" model="ir.ui.view">
        <field name="name">hr.document.request.form</field>
        <field name="model">hr.document.request</field>
        <field name="arch" type="xml">
            <form string="Demande de document administratif">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,processing,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id" class="oe_edit_only"/>
                        <h1>
                            <field name="employee_id" placeholder="Sélectionner l'employé..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Détails du document">
                            <field name="document_type"/>
                            <field name="custom_type_label" invisible="document_type != 'autre'"/>
                            <field name="period_month" invisible="document_type != 'bulletin_paie'"/>
                            <field name="period_year" invisible="document_type != 'bulletin_paie'"/>
                            <field name="comment"/>
                        </group>
                        <group string="Traitement RH &amp; Fichier">
                            <field name="request_date"/>
                            <field name="processed_date"/>
                            <field name="file_attachment_base64" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="rejection_reason" invisible="status != 'rejected'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hr_document_request_tree" model="ir.ui.view">
        <field name="name">hr.document.request.tree</field>
        <field name="model">hr.document.request</field>
        <field name="arch" type="xml">
            <tree string="Demandes de documents administratifs">
                <field name="request_date"/>
                <field name="employee_id"/>
                <field name="document_type"/>
                <field name="status" widget="badge" decoration-info="status == 'pending'" decoration-warning="status == 'processing'" decoration-success="status in ('ready', 'delivered')" decoration-danger="status == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_document_request" model="ir.actions.act_window">
        <field name="name">Demandes de Documents</field>
        <field name="res_model">hr.document.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_hr_document_request"
              name="Demandes de Documents"
              parent="hr.menu_hr_root"
              action="action_hr_document_request"
              sequence="90"/>
</odoo>

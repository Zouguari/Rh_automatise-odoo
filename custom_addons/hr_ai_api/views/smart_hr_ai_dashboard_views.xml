<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_hr_ai_dashboard_form" model="ir.ui.view">
        <field name="name">smart.hr.ai.dashboard.form</field>
        <field name="model">smart.hr.ai.dashboard</field>
        <field name="arch" type="xml">
            <form string="Tableau de Bord Global Smart HR AI" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Recrutement &amp; Onboarding IA">
                            <field name="recruited_employees_count"/>
                            <field name="onboarded_employees_count"/>
                            <field name="onboarding_completion_rate" widget="progressbar"/>
                        </group>
                        <group string="Performance IA &amp; Compétences">
                            <field name="avg_recruitment_ai_score" widget="progressbar"/>
                            <field name="avg_skills_coverage" widget="progressbar"/>
                            <field name="avg_employee_performance_score" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Indicateurs Lifecycle &amp; Suivi">
                            <field name="appraisal_employees_count"/>
                            <field name="skills_gap_employees_count"/>
                            <field name="training_rec_employees_count"/>
                        </group>
                        <group string="Alertes &amp; Module Opérationnel">
                            <field name="attendance_anomalies_count"/>
                            <field name="leave_recommendations_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-3" role="status">
                        <strong>ℹ️ Indicateurs d'intégration Lifecycle :</strong> Les statistiques ci-dessus sont calculées en temps réel à partir des enregistrements de Recrutement IA, Onboarding Automatique, Évaluations de compétences, Présences et Congés.
                    </div>

                    <div class="alert alert-secondary mt-3 d-flex justify-content-between align-items-center" role="status" invisible="not latest_weekly_summary_id">
                        <div>
                            <strong>🗓️ Résumé hebdomadaire RH :</strong>
                            <field name="latest_weekly_summary_headline" readonly="1" nolabel="1" class="ms-1"/>
                        </div>
                        <div>
                            <button name="action_open_latest_weekly_summary" type="object"
                                    string="Voir le résumé complet" class="btn btn-link"/>
                            <button name="action_generate_current_week_snapshot" type="object"
                                    string="🔄 Aperçu semaine en cours" class="btn btn-link"
                                    help="Génère (ou régénère) un aperçu à jour de la semaine en cours, toutes équipes confondues — utile juste après un événement du jour (embauche, congé...) sans attendre le rapport officiel du lundi suivant."/>
                        </div>
                    </div>
                    <div class="alert alert-secondary mt-3" role="status" invisible="latest_weekly_summary_id">
                        Aucun résumé hebdomadaire généré pour le moment.
                        <button name="action_generate_current_week_snapshot" type="object"
                                string="Générer un aperçu de la semaine en cours" class="btn btn-link"/>
                    </div>
                    <field name="latest_weekly_summary_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Record singleton par défaut chargé par l'action act_window -->
    <record id="smart_hr_ai_dashboard_default" model="smart.hr.ai.dashboard">
        <field name="name">Vue d'ensemble Smart HR AI</field>
    </record>

    <!-- Action Fenêtre (ir.actions.act_window) standard pointant sur le record singleton -->
    <record id="action_smart_hr_ai_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord IA</field>
        <field name="res_model">smart.hr.ai.dashboard</field>
        <field name="res_id" ref="smart_hr_ai_dashboard_default"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>

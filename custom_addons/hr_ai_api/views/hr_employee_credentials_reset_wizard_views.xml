<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_credentials_reset_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.credentials.reset.wizard.form</field>
        <field name="model">hr.employee.credentials.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Nouveau mot de passe temporaire">
                <div style="background-color: #fffbe6; border-left: 4px solid #f59e0b; padding: 14px; margin-bottom: 18px; border-radius: 4px;">
                    <p style="margin: 0; color: #92400e; font-weight: bold; font-size: 13px;">
                        ⚠️ AVERTISSEMENT DE SÉCURITÉ :
                    </p>
                    <p style="margin: 4px 0 0 0; color: #78350f; font-size: 12px; line-height: 18px;">
                        Ce mot de passe temporaire ne sera plus <strong>JAMAIS</strong> réaffiché une fois cette fenêtre fermée. Veuillez le copier ou le transmettre au collaborateur dès maintenant.
                    </p>
                </div>
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="temp_password" readonly="1" class="oe_inline" style="font-size: 16px; font-weight: bold; color: #4338ca; letter-spacing: 1px;"/>
                </group>
                <footer>
                    <button string="Fermer" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste -->
    <record id="view_hr_recruitment_ai_generator_tree" model="ir.ui.view">
        <field name="name">hr.recruitment.ai.generator.tree</field>
        <field name="model">hr.recruitment.ai.generator</field>
        <field name="arch" type="xml">
            <tree string="Générations de Descriptions">
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'generated'"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_hr_recruitment_ai_generator_form" model="ir.ui.view">
        <field name="name">hr.recruitment.ai.generator.form</field>
        <field name="model">hr.recruitment.ai.generator</field>
        <field name="arch" type="xml">
            <form string="Générateur de Description de Poste">
                <header>
                    <button name="action_generate_description" 
                            string="Générer avec l'IA" 
                            type="object" 
                            class="oe_highlight btn-primary" 
                            invisible="state == 'generated'"
                            icon="fa-magic"/>
                    <button name="action_generate_description" 
                            string="Régénérer avec l'IA" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="state == 'draft'"
                            icon="fa-refresh"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Titre du poste ciblé"/>
                        <h1>
                            <field name="name" placeholder="Ex: Développeur Odoo / Python"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Critères &amp; Compétences" name="criteria_page">
                            <group>
                                <field name="key_skills" 
                                       placeholder="Saisissez ici les compétences, outils et prérequis (ex: Python, Odoo, PostgreSQL, Docker, Git...)" 
                                       style="min-height: 120px;"/>
                            </group>
                        </page>
                        <page string="Description Générée" name="description_page">
                            <field name="generated_description" widget="html" options="{'style-inline': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Fenêtre -->
    <record id="action_hr_recruitment_ai_generator" model="ir.actions.act_window">
        <field name="name">Générateur de Poste</field>
        <field name="res_model">hr.recruitment.ai.generator</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première description de poste avec l'IA !
            </p>
            <p>
                Renseignez le titre du poste et les compétences clés, puis cliquez sur "Générer avec l'IA".
            </p>
        </field>
    </record>

    <!-- Classement des meilleurs candidats (tri par score IA décroissant) -->
    <!-- Classement des meilleurs candidats (tri par score IA décroissant) -->
    <record id="view_hr_applicant_ranking_kanban" model="ir.ui.view">
        <field name="name">hr.applicant.ranking.kanban</field>
        <field name="model">hr.applicant</field>
        <field name="arch" type="xml">
            <kanban create="false" default_order="ai_score desc">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card p-3 mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong><field name="partner_name"/></strong>
                            </div>
                            <div class="text-muted small">
                                <field name="job_id"/>
                            </div>
                            <div class="mt-2">
                                <field name="ai_score" widget="progressbar" options="{'max_value': 100}"/>
                            </div>
                            <div class="mt-1">
                                <field name="ai_recommendation" widget="badge"
                                       decoration-success="ai_recommendation == 'highly_recommended'"
                                       decoration-info="ai_recommendation == 'recommended'"
                                       decoration-warning="ai_recommendation == 'neutral'"
                                       decoration-danger="ai_recommendation == 'not_recommended'"/>
                            </div>
                            <div class="mt-2 small text-muted">
                                <field name="ai_summary"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_applicant_ranking_tree" model="ir.ui.view">
        <field name="name">hr.applicant.ranking.tree</field>
        <field name="model">hr.applicant</field>
        <field name="arch" type="xml">
            <tree string="Classement IA des candidats" create="false" default_order="ai_score desc" decoration-muted="active == False">
                <field name="active" column_invisible="1"/>
                <field name="partner_name" string="Candidat"/>
                <field name="job_id" string="Poste"/>
                <field name="stage_id" string="Étape"/>
                <field name="user_id" string="Recruteur"/>
                <field name="ai_score" string="Score IA (%)" widget="progressbar" options="{'max_value': 100}"/>
                <field name="ai_recommendation" string="Recommandation" widget="badge"
                       decoration-success="ai_recommendation == 'highly_recommended'"
                       decoration-info="ai_recommendation == 'recommended'"
                       decoration-warning="ai_recommendation == 'neutral'"
                       decoration-danger="ai_recommendation == 'not_recommended'"/>
                <field name="ai_summary" string="Résumé IA"/>
            </tree>
        </field>
    </record>

    <record id="action_hr_applicant_ranking" model="ir.actions.act_window">
        <field name="name">Meilleurs candidats</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_hr_applicant_ranking_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hr_applicant_ranking_tree')}),
        ]"/>
        <field name="domain">[('ai_score', '&gt;', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun candidat évalué par l'IA pour le moment.
            </p>
            <p>
                Lance le bouton "🚀 Pipeline IA complet" (ou juste "Calculer le score")
                sur un candidat pour qu'il apparaisse ici, classé automatiquement
                du meilleur profil au moins bon.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_hr_recruitment_ai_root" 
              name="Assistant RH IA" 
              web_icon="hr_recruitment_ai_assistant,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_hr_recruitment_ai_generator" 
              name="Générateur de Poste" 
              parent="menu_hr_recruitment_ai_root" 
              action="action_hr_recruitment_ai_generator" 
              sequence="10"/>

    <menuitem id="menu_hr_applicant_ranking"
              name="Meilleurs candidats"
              parent="menu_hr_recruitment_ai_root"
              action="action_hr_applicant_ranking"
              sequence="5"/>
</odoo>
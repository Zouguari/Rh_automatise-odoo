<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_form_ai_inherit" model="ir.ui.view">
        <field name="name">hr.job.form.ai.inherit</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="%(action_hr_applicant_bulk_import_wizard)d" type="action"
                        class="oe_stat_button" icon="fa-upload"
                        context="{'default_job_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Importer</span>
                        <span class="o_stat_text">plusieurs CV</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Exigences IA" name="ai_requirements">
                    <group>
                        <field name="required_skills" placeholder="Python&#10;Django&#10;PostgreSQL"/>
                        <field name="required_experience_years"/>
                        <field name="required_education_level"/>
                    </group>
                    <button name="action_generate_job_description_ai"
                            type="object"
                            string="Générer la description Odoo avec l'IA"
                            class="oe_highlight btn-primary"
                            icon="fa-magic"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
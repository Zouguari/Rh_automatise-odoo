<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_form_ai_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.form.ai.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <!-- Bouton d'action dans le header -->
            <xpath expr="//header" position="inside">
                <button name="action_reset_ai_processing" type="object"
                        string="Relancer analyse IA" class="btn-secondary"/>
                <button name="action_extract_cv_text" type="object"
                        string="Extraire texte du CV" class="btn-primary"/>
                <button name="action_ai_extract_structured_data" type="object"
                        string="Analyser avec l'IA" class="btn-primary"
                        invisible="cv_extraction_state != 'extracted'"/>
                <button name="action_detect_duplicates" type="object"
                        string="Vérifier doublons" class="btn-secondary"/>
                <button name="action_compute_match_score" type="object"
                        string="Calculer le score" class="btn-primary"
                        invisible="ai_processing_state != 'done'"/>
                <button name="action_generate_interview_questions" type="object"
                        string="Générer questions entretien" class="btn-secondary"/>
                <button name="action_schedule_interview" type="object"
                        string="Planifier entretien" class="btn-secondary"/>
                <field name="ai_processing_state" widget="statusbar"/>
                <field name="cv_extraction_state" widget="statusbar"/>
            </xpath>

            <!-- Nouvel onglet dédié à l'IA -->
            <xpath expr="//notebook" position="inside">
                <page string="Analyse IA" name="ai_analysis">
                    <div class="alert alert-warning" role="alert" invisible="not is_potential_duplicate">
                        <strong>⚠️ Doublon potentiel détecté</strong> — ce candidat correspond peut-être à une candidature existante.
                    </div>
                    <group>
                        <group string="Score et recommandation">
                            <field name="ai_score" widget="progressbar"/>
                            <field name="ai_recommendation"/>
                            <field name="ai_score_explanation" placeholder="Explication du score..."/>
                        </group>
                        <group string="Compétences">
                            <field name="ai_matched_skills" readonly="1"/>
                            <field name="ai_missing_skills" readonly="1"/>
                        </group>
                        <group string="Doublons">
                            <field name="is_potential_duplicate"/>
                            <field name="duplicate_applicant_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Résumé">
                        <field name="ai_summary" nolabel="1"/>
                    </group>
                    <group string="Entretien">
                        <field name="interview_event_id"/>
                        <field name="ai_interview_questions" placeholder="Questions d'entretien..." readonly="1"/>
                    </group>
                    <group string="Données extraites">
                        <field name="extracted_skills"/>
                        <field name="extracted_education"/>
                        <field name="extracted_experience"/>
                        <field name="extracted_languages"/>
                        <field name="extracted_certifications"/>
                    </group>
                    <group string="Texte brut du CV">
                        <field name="cv_raw_text" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Debug - Réponse brute Gemini">
                        <field name="ai_extraction_raw" nolabel="1" readonly="1"/>
                    </group>
                </page>
                <page string="Onboarding" name="onboarding" invisible="not emp_id">
                    <group string="Contrat">
                        <field name="generated_contract_id"/>
                    </group>
                    <group string="Tâches d'onboarding">
                        <field name="onboarding_task_ids">
                            <tree>
                                <field name="name"/>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Ajout du score dans la vue liste -->
    <record id="hr_applicant_list_ai_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.list.ai.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">ai_score desc</attribute>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="ai_score" optional="show"/>
                <field name="ai_recommendation" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>

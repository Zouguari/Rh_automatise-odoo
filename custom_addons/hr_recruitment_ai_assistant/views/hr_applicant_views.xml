<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_form_ai_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.form.ai.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <!-- Bouton d'action dans le header -->
            <xpath expr="//header" position="inside">
                <button name="action_run_full_ai_pipeline" type="object"
                        string="🚀 Pipeline IA complet" class="btn-primary"
                        invisible="not id"
                        confirm="Ceci va enchaîner automatiquement : extraction du CV, analyse IA et calcul du score de correspondance. Continuer ?"/>
                <button name="action_reset_ai_processing" type="object"
                        string="Relancer analyse IA" class="btn-secondary"/>
                <button name="action_ai_extract_structured_data" type="object"
                        string="Analyser avec l'IA" class="btn-primary"/>
                <button name="action_detect_duplicates" type="object"
                        string="Vérifier doublons" class="btn-secondary"/>
                <button name="action_open_merge_wizard" type="object"
                        string="⚠️ Fusionner les doublons" class="btn-warning"
                        invisible="not is_potential_duplicate"/>
                <button name="action_compute_match_score" type="object"
                        string="Calculer le score" class="btn-primary"
                        invisible="ai_processing_state != 'done'"/>
                <button name="action_suggest_job" type="object"
                        string="🎯 Suggérer un poste" class="btn-secondary"
                        invisible="job_id or ai_processing_state != 'done'"/>
                <button name="action_assign_suggested_job" type="object"
                        string="✅ Assigner ce poste" class="btn-primary"
                        invisible="not ai_suggested_job_id"
                        confirm="Confirmer l'assignation du poste suggéré par l'IA ?"/>
                <button name="action_generate_interview_questions" type="object"
                        string="Générer questions entretien" class="btn-secondary"/>
                <button name="action_schedule_interview" type="object"
                        string="Planifier entretien" class="btn-secondary"/>
                <field name="ai_processing_state" widget="statusbar"/>
                <field name="cv_extraction_state" widget="statusbar"/>
            </xpath>

            <!-- Smart button Employé créé -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_employee" type="object"
                        class="oe_stat_button" icon="fa-id-card"
                        invisible="not emp_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Employé créé</span>
                    </div>
                </button>
            </xpath>

            <!-- Nouvel onglet dédié à l'IA -->
            <xpath expr="//notebook" position="inside">
                <page string="Analyse IA" name="ai_analysis">
                    <div class="alert alert-secondary" role="alert" invisible="not refuse_reason_id">
                        <strong>❌ Candidature refusée</strong> — Motif :
                        <field name="refuse_reason_id" readonly="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_potential_duplicate">
                        <strong>⚠️ Doublon potentiel détecté</strong> — ce candidat correspond peut-être à une candidature existante.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not ai_suggested_job_id">
                        <strong>🎯 Poste suggéré par l'IA : </strong>
                        <field name="ai_suggested_job_id" readonly="1" class="oe_inline"/>
                        <br/>
                        <field name="ai_job_match_reason" readonly="1"/>
                    </div>
                    <group>
                        <group string="Score et recommandation">
                            <field name="ai_score" widget="progressbar"/>
                            <field name="ai_recommendation"/>
                            <field name="ai_score_explanation" placeholder="Explication du score..."/>
                        </group>
                        <group string="Analyse des compétences">
                            <field name="ai_matched_skills" readonly="1"/>
                            <field name="ai_missing_skills" readonly="1"/>
                        </group>
                    </group>

                    <group string="Résumé du CV">
                        <field name="ai_summary" nolabel="1" colspan="2" placeholder="Résumé automatique du CV..."/>
                    </group>

                    <group string="Entretien &amp; Questions IA">
                        <field name="interview_ids" nolabel="1" colspan="2">
                            <tree editable="false">
                                <field name="name"/>
                                <field name="calendar_event_id"/>
                                <field name="questions"/>
                            </tree>
                        </field>
                    </group>

                    <group string="Données extraites du CV">
                        <group string="Formation &amp; Langues">
                            <field name="extracted_education_level"/>
                            <field name="extracted_education"/>
                            <field name="extracted_languages"/>
                            <field name="extracted_certifications"/>
                        </group>
                        <group string="Expérience &amp; Compétences">
                            <field name="extracted_skills"/>
                            <field name="extracted_experience"/>
                        </group>
                    </group>

                    <group string="Gestion des doublons" invisible="not is_potential_duplicate">
                        <field name="is_potential_duplicate"/>
                        <field name="duplicate_applicant_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </page>
                <page string="Debug / Technique" name="ai_debug" groups="base.group_no_one">
                    <group string="Texte brut du CV">
                        <field name="cv_raw_text" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Debug - Compétences extraites avec niveau (JSON)">
                        <field name="extracted_skills_detailed" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Debug - Réponse brute Gemini">
                        <field name="ai_extraction_raw" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </page>
                <page string="Historique des scores" name="score_history">
                    <field name="score_history_ids" readonly="1">
                        <tree string="Historique des scores" create="false" edit="false" delete="false">
                            <field name="create_date" string="Date"/>
                            <field name="job_id" string="Poste"/>
                            <field name="score" string="Score (%)" widget="progressbar" options="{'max_value': 100}"/>
                            <field name="recommendation" widget="badge"
                                   decoration-success="recommendation == 'highly_recommended'"
                                   decoration-info="recommendation == 'recommended'"
                                   decoration-warning="recommendation == 'neutral'"
                                   decoration-danger="recommendation == 'not_recommended'"/>
                            <field name="computed_by" string="Par"/>
                            <field name="explanation" string="Justification"/>
                        </tree>
                    </field>
                </page>
                <page string="Onboarding" name="onboarding" invisible="not emp_id">
                    <group string="Contrat">
                        <field name="generated_contract_id"/>
                    </group>
                    <group string="Tâches d'onboarding">
                        <field name="onboarding_task_ids">
                            <tree>
                                <field name="name"/>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Ajout du score dans la vue liste -->
    <record id="hr_applicant_list_ai_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.list.ai.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">ai_score desc</attribute>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="ai_score" optional="show"/>
                <field name="ai_recommendation" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
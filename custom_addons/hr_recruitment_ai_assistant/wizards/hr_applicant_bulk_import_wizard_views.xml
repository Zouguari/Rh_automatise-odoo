<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_bulk_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.applicant.bulk.import.wizard.form</field>
        <field name="model">hr.applicant.bulk.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer plusieurs CV">
                <p>
                    Sélectionne un poste et dépose plusieurs fichiers CV
                    (PDF/DOCX) : un candidat sera créé automatiquement pour
                    chaque fichier, avec son CV déjà attaché.
                </p>
                <group>
                    <field name="job_id"/>
                    <field name="run_pipeline_automatically"/>
                </group>
                <field name="cv_attachment_ids" widget="many2many_binary"
                       string="Fichiers CV à importer"/>
                <footer>
                    <button name="action_import" type="object"
                            string="Importer" class="btn-primary"
                            confirm="Ceci va créer un candidat par fichier CV sélectionné. Continuer ?"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_applicant_bulk_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer plusieurs CV</field>
        <field name="res_model">hr.applicant.bulk.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

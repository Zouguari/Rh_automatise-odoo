<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Champs IA visibles sur la fiche congé standard -->
    <record id="view_hr_leave_form_ai_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.ai.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compute_ai_recommendation"
                        string="Recalculer l'analyse IA"
                        type="object"
                        class="btn-secondary"
                        icon="fa-magic"
                        invisible="not id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Analyse IA Smart HR" name="ai_analysis_group">
                    <group>
                        <field name="ai_recommendation"
                               widget="badge"
                               decoration-success="ai_recommendation == 'approve'"
                               decoration-warning="ai_recommendation == 'caution'"
                               decoration-danger="ai_recommendation == 'refuse'"/>
                        <field name="ai_conflict_count"/>
                        <field name="ai_computed_on"/>
                    </group>
                    <group>
                        <field name="ai_justification" nolabel="1" colspan="2"
                               placeholder="La justification IA apparaîtra après l'analyse."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Colonne recommandation IA dans la liste standard -->
    <record id="view_hr_leave_tree_ai_inherit" model="ir.ui.view">
        <field name="name">hr.leave.tree.ai.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="ai_recommendation" optional="show" widget="badge"
                       decoration-success="ai_recommendation == 'approve'"
                       decoration-warning="ai_recommendation == 'caution'"
                       decoration-danger="ai_recommendation == 'refuse'"/>
                <field name="ai_conflict_count" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_leave_ai_list" model="ir.ui.view">
        <field name="name">hr.leave.ai.list</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <tree string="Demandes de congés IA" default_order="request_date_from desc"
                  decoration-success="ai_recommendation == 'approve'"
                  decoration-warning="ai_recommendation == 'caution'"
                  decoration-danger="ai_recommendation == 'refuse'">
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
                <field name="number_of_days"/>
                <field name="ai_recommendation" widget="badge"
                       decoration-success="ai_recommendation == 'approve'"
                       decoration-warning="ai_recommendation == 'caution'"
                       decoration-danger="ai_recommendation == 'refuse'"/>
                <field name="ai_conflict_count"/>
                <field name="ai_computed_on"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_leave_ai_form" model="ir.ui.view">
        <field name="name">hr.leave.ai.form</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <form string="Demande de congé — analyse IA">
                <header>
                    <button name="action_compute_ai_recommendation"
                            string="Recalculer l'analyse IA"
                            type="object"
                            class="oe_highlight"
                            icon="fa-magic"/>
                    <field name="state" widget="statusbar" statusbar_visible="confirm,validate"/>
                </header>
                <sheet>
                    <field name="employee_company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="employee_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="holiday_status_id"/>
                            <field name="request_date_from"/>
                            <field name="request_date_to"/>
                            <field name="number_of_days"/>
                        </group>
                        <group string="Recommandation IA">
                            <field name="ai_recommendation" widget="badge"
                                   decoration-success="ai_recommendation == 'approve'"
                                   decoration-warning="ai_recommendation == 'caution'"
                                   decoration-danger="ai_recommendation == 'refuse'"/>
                            <field name="ai_conflict_count"/>
                            <field name="ai_computed_on"/>
                        </group>
                    </group>
                    <group string="Justification de l'analyse">
                        <field name="ai_justification" nolabel="1"
                               placeholder="La justification IA apparaîtra après l'analyse."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_leave_ai_search" model="ir.ui.view">
        <field name="name">hr.leave.ai.search</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <search string="Rechercher des congés IA">
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
                <field name="ai_recommendation"/>
                <filter string="À approuver (IA)" name="ai_approve"
                        domain="[('ai_recommendation', '=', 'approve')]"/>
                <filter string="Vigilance (IA)" name="ai_caution"
                        domain="[('ai_recommendation', '=', 'caution')]"/>
                <filter string="À refuser (IA)" name="ai_refuse"
                        domain="[('ai_recommendation', '=', 'refuse')]"/>
                <filter string="Conflits d'équipe" name="ai_conflicts"
                        domain="[('ai_conflict_count', '>', 0)]"/>
                <filter string="En attente de validation" name="pending"
                        domain="[('state', 'in', ('confirm', 'validate1'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Employé" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Recommandation IA" name="group_ai" context="{'group_by': 'ai_recommendation'}"/>
                    <filter string="Type de congé" name="group_type" context="{'group_by': 'holiday_status_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_leave_ai_recommendation_list" model="ir.ui.view">
        <field name="name">hr.leave.ai.recommendation.list</field>
        <field name="model">hr.leave.ai.recommendation</field>
        <field name="arch" type="xml">
            <tree string="Historique des recommandations IA" default_order="create_date desc">
                <field name="leave_id"/>
                <field name="recommendation" widget="badge"
                       decoration-success="recommendation == 'approve'"
                       decoration-warning="recommendation == 'caution'"
                       decoration-danger="recommendation == 'refuse'"/>
                <field name="conflict_count"/>
                <field name="justification"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_leave_ai_recommendation_form" model="ir.ui.view">
        <field name="name">hr.leave.ai.recommendation.form</field>
        <field name="model">hr.leave.ai.recommendation</field>
        <field name="arch" type="xml">
            <form string="Recommandation IA">
                <sheet>
                    <group>
                        <field name="leave_id"/>
                        <field name="recommendation" widget="badge"/>
                        <field name="conflict_count"/>
                        <field name="create_date"/>
                    </group>
                    <group string="Justification">
                        <field name="justification" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_ai" model="ir.actions.act_window">
        <field name="name">Demandes de congés IA</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hr_leave_ai_search"/>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hr_leave_ai_list')}),
                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_leave_ai_form')})]"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune demande de congé analysée pour le moment.
            </p>
            <p>Les demandes sont analysées automatiquement à leur création (solde + conflits d'équipe).</p>
        </field>
    </record>

    <record id="action_hr_leave_ai_caution" model="ir.actions.act_window">
        <field name="name">Congés — Vigilance IA</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hr_leave_ai_search"/>
        <field name="domain">[('ai_recommendation', '=', 'caution')]</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hr_leave_ai_list')}),
                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_leave_ai_form')})]"/>
    </record>

    <record id="action_hr_leave_ai_recommendation" model="ir.actions.act_window">
        <field name="name">Historique des recommandations IA</field>
        <field name="res_model">hr.leave.ai.recommendation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hr_leave_ai"
              name="Congés IA"
              parent="hr_holidays.menu_hr_holidays_root"
              action="action_hr_leave_ai"
              sequence="35"/>

    <menuitem id="menu_hr_leave_ai_caution"
              name="Demandes en vigilance"
              parent="menu_hr_leave_ai"
              action="action_hr_leave_ai_caution"
              sequence="5"/>

    <menuitem id="menu_hr_leave_ai_recommendation"
              name="Historique des analyses"
              parent="menu_hr_leave_ai"
              action="action_hr_leave_ai_recommendation"
              sequence="10"/>

</odoo>

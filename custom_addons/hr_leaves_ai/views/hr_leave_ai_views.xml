<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Champs IA visibles sur la fiche congé standard -->
    <record id="view_hr_leave_form_ai_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.ai.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve"
                        string="Approuver la demande"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('confirm', 'validate1')"/>
                <button name="action_refuse"
                        string="Refuser la demande"
                        type="object"
                        class="btn-danger"
                        invisible="state not in ('confirm', 'validate1', 'validate')"/>
                <button name="action_compute_ai_recommendation"
                        string="Recalculer l'analyse IA"
                        type="object"
                        class="btn-secondary"
                        icon="fa-magic"
                        invisible="not id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Analyse IA Smart HR" name="ai_analysis_group">
                    <group>
                        <field name="ai_recommendation"
                               widget="badge"
                               decoration-success="ai_recommendation == 'approve'"
                               decoration-warning="ai_recommendation == 'caution'"
                               decoration-danger="ai_recommendation == 'refuse'"/>
                        <field name="ai_conflict_count"/>
                        <field name="ai_computed_on"/>
                    </group>
                    <group>
                        <field name="ai_justification" nolabel="1" colspan="2"
                               placeholder="La justification IA apparaîtra après l'analyse."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Colonne recommandation IA dans la liste standard -->
    <record id="view_hr_leave_tree_ai_inherit" model="ir.ui.view">
        <field name="name">hr.leave.tree.ai.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="ai_recommendation" optional="show" widget="badge"
                       decoration-success="ai_recommendation == 'approve'"
                       decoration-warning="ai_recommendation == 'caution'"
                       decoration-danger="ai_recommendation == 'refuse'"/>
                <field name="ai_conflict_count" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_leave_ai_list" model="ir.ui.view">
        <field name="name">hr.leave.ai.list</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <tree string="Demandes de congés IA" default_order="request_date_from desc"
                  decoration-success="ai_recommendation == 'approve'"
                  decoration-warning="ai_recommendation == 'caution'"
                  decoration-danger="ai_recommendation == 'refuse'">
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
                <field name="number_of_days"/>
                <field name="ai_recommendation" widget="badge"
                       decoration-success="ai_recommendation == 'approve'"
                       decoration-warning="ai_recommendation == 'caution'"
                       decoration-danger="ai_recommendation == 'refuse'"/>
                <field name="ai_conflict_count"/>
                <field name="ai_computed_on"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_leave_ai_form" model="ir.ui.view">
        <field name="name">hr.leave.ai.form</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <form string="Demande de congé — analyse IA">
                <header>
                    <button name="action_approve"
                            string="Approuver la demande"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('confirm', 'validate1')"/>
                    <button name="action_refuse"
                            string="Refuser la demande"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ('confirm', 'validate1', 'validate')"/>
                    <button name="action_compute_ai_recommendation"
                            string="Recalculer l'analyse IA"
                            type="object"
                            class="btn-secondary"
                            icon="fa-magic"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="confirm,validate"/>
                </header>
                <sheet>
                    <field name="employee_company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="employee_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="holiday_status_id"/>
                            <field name="request_date_from"/>
                            <field name="request_date_to"/>
                            <field name="number_of_days"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Analyse IA Smart HR" name="ai_analysis_group">
                        <group>
                            <field name="ai_recommendation"
                                   widget="badge"
                                   decoration-success="ai_recommendation == 'approve'"
                                   decoration-warning="ai_recommendation == 'caution'"
                                   decoration-danger="ai_recommendation == 'refuse'"/>
                            <field name="ai_conflict_count"/>
                            <field name="ai_computed_on"/>
                        </group>
                        <group>
                            <field name="ai_justification" nolabel="1" colspan="2"
                                   placeholder="La justification IA apparaîtra après l'analyse."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour le menu "Demandes de congés (IA)" -->
    <record id="action_hr_leave_ai_recommendations" model="ir.actions.act_window">
        <field name="name">Demandes de congés (IA)</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hr_leave_ai_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_leave_ai_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune demande de congé enregistrée pour le moment.
            </p>
        </field>
    </record>

</odoo>
